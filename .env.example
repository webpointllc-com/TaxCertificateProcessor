PORT=3000
NODE_ENV=development
# Render Postgres. Required in production (ephemeral disk — do not store orders on local files).
DATABASE_URL=
# Groq (Search Spul LLM). Lookup and certificate drafts work without it; RAG chat needs it.
GROQ_API_KEY=
# Own LLM (RunPod serverless vLLM). Pay-day only. Never commit the URL or key.
# WEBPOINT_LLM_URL=
# WEBPOINT_LLM_KEY=
# MODEL_PROVIDER=webpoint
# WEBPOINT_MODEL=Qwen/Qwen3.5-9B
# Optional: lock the Squarespace members iframe to this key (?k= on the embed URL).
MEMBER_EMBED_KEY=
# Optional: path to the Workplace Technologies clone on the WD Passport.
WORKPLACE_CLONE_PATH=
# Session signing is not used for the embed (third-party iframe cookies are blocked).
# The tool uses an X-Session-Id header stored in the iframe's localStorage.
