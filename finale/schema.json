{
  "name": "DR Production Results",
  "product": "TCS / RDS production row",
  "talk": "whole_row_unless_user_names_a_field",
  "note": "Same 40 columns across counties. Parcel number format is per tax collecting entity, stored on that county's extractor. Empty cells stay empty. Do not invent amounts or URLs.",
  "aliases": {
    "CR/Orig": "CYR Dlq",
    "PIN/Acq": "PYR Dlq",
    "Taxsale": "Tax Sale",
    "Tax id": "Tax Id"
  },
  "agency_to_jurisdiction": {
    "OH-Hamilton": { "state": "OH", "county": "Hamilton", "keys": ["OH-Hamilton"] },
    "CT-HartfordCity": { "state": "CT", "county": "Hartford City", "keys": ["CT-HartfordCity", "CT-Hartford"] },
    "IL-Sangamon": { "state": "IL", "county": "Sangamon", "keys": ["IL-Sangamon"] }
  },
  "parcel_formats": {
    "OH-Hamilton": "###-####-####-##",
    "CT-HartfordCity": "#########",
    "IL-Sangamon": "tax id and parcel number may differ; do not reuse another county's hyphenation"
  },
  "columns": [
    { "header": "Agency Name", "key": "agency_name", "aliases": ["agency"], "meaning": "Workplace/WebPoint agency slot, usually STATE-County or STATE-City." },
    { "header": "Reference", "key": "reference", "aliases": ["ref", "file number"], "meaning": "Internal production reference for this pull." },
    { "header": "Tax Id", "key": "tax_id", "aliases": ["tax id", "taxid", "account"], "meaning": "Collector account / tax identifier. May match Parcel Number or may differ." },
    { "header": "Parcel Number", "key": "parcel_number", "aliases": ["parcel", "apn", "pin", "parcel id"], "meaning": "Normalized parcel identifier for that county. Format is county-specific." },
    { "header": "CYR Dlq", "key": "cyr_dlq", "aliases": ["cr/orig", "current year delinquent", "cyr"], "meaning": "Whether current-year tax is delinquent." },
    { "header": "PYR Dlq", "key": "pyr_dlq", "aliases": ["pin/acq", "prior year delinquent", "pyr"], "meaning": "Whether prior-year tax is delinquent." },
    { "header": "Tax Sale", "key": "tax_sale", "aliases": ["taxsale"], "meaning": "Tax-sale flag or note when the collector reports one." },
    { "header": "Parcel Notes", "key": "parcel_notes", "aliases": ["notes"], "meaning": "Free-text exceptions the extractor or operator saved for this parcel." },
    { "header": "As Of", "key": "as_of", "aliases": ["as-of", "as of date"], "meaning": "As-of date of the production pull." },
    { "header": "Bill Year", "key": "bill_year", "aliases": ["tax year", "year"], "meaning": "Tax / bill year on the collector." },
    { "header": "Bill Type", "key": "bill_type", "aliases": ["type"], "meaning": "Bill class when the collector distinguishes them." },
    { "header": "Bill Number", "key": "bill_number", "aliases": ["bill #", "bill no"], "meaning": "Collector bill number." },
    { "header": "Bill Notes", "key": "bill_notes", "aliases": [], "meaning": "Notes attached to this bill, not the parcel." },
    { "header": "Bill Amount", "key": "bill_amount", "aliases": ["total billed"], "meaning": "Amount billed for that year. Confirm on the collector before closing." },
    { "header": "Balance Due", "key": "balance_due", "aliases": ["balance", "amount due"], "meaning": "Open balance on that bill." },
    { "header": "Inst 1 Date", "key": "inst_1_date", "aliases": ["installment 1 date", "first installment date"], "meaning": "First installment due date." },
    { "header": "Inst 1 Amt", "key": "inst_1_amt", "aliases": ["installment 1 amount", "first installment"], "meaning": "First installment amount." },
    { "header": "Inst 1 Bal", "key": "inst_1_bal", "aliases": ["installment 1 balance"], "meaning": "Remaining balance on installment 1." },
    { "header": "Inst 2 Date", "key": "inst_2_date", "aliases": ["installment 2 date", "second installment date"], "meaning": "Second installment due date." },
    { "header": "Inst 2 Amt", "key": "inst_2_amt", "aliases": ["installment 2 amount", "second installment"], "meaning": "Second installment amount." },
    { "header": "Inst 2 Bal", "key": "inst_2_bal", "aliases": ["installment 2 balance"], "meaning": "Remaining balance on installment 2." },
    { "header": "Inst 3 Date", "key": "inst_3_date", "aliases": ["installment 3 date"], "meaning": "Third installment due date when the collector uses one." },
    { "header": "Inst 3 Amt", "key": "inst_3_amt", "aliases": ["installment 3 amount"], "meaning": "Third installment amount." },
    { "header": "Inst 3 Bal", "key": "inst_3_bal", "aliases": ["installment 3 balance"], "meaning": "Remaining balance on installment 3." },
    { "header": "Inst 4 Date", "key": "inst_4_date", "aliases": ["installment 4 date"], "meaning": "Fourth installment due date when the collector uses one." },
    { "header": "Inst 4 Amt", "key": "inst_4_amt", "aliases": ["installment 4 amount"], "meaning": "Fourth installment amount." },
    { "header": "Inst 4 Bal", "key": "inst_4_bal", "aliases": ["installment 4 balance"], "meaning": "Remaining balance on installment 4." },
    { "header": "Bill Redemption", "key": "bill_redemption", "aliases": ["redemption"], "meaning": "Bill-level redemption amount if reported." },
    { "header": "Redemption Expires", "key": "redemption_expires", "aliases": ["redemption expiration"], "meaning": "When bill-level redemption expires." },
    { "header": "Parcel Redemption 1", "key": "parcel_redemption_1", "aliases": [], "meaning": "First parcel-level redemption amount." },
    { "header": "Redemption 1 Expires", "key": "redemption_1_expires", "aliases": [], "meaning": "Expiration for parcel redemption 1." },
    { "header": "Parcel Redemption 2", "key": "parcel_redemption_2", "aliases": [], "meaning": "Second parcel-level redemption amount." },
    { "header": "Redemption 2 Expires", "key": "redemption_2_expires", "aliases": [], "meaning": "Expiration for parcel redemption 2." },
    { "header": "Parcel Redemption 3", "key": "parcel_redemption_3", "aliases": [], "meaning": "Third parcel-level redemption amount." },
    { "header": "Redemption 3 Expires", "key": "redemption_3_expires", "aliases": [], "meaning": "Expiration for parcel redemption 3." },
    { "header": "Total Assessed Value", "key": "total_assessed_value", "aliases": ["assessed", "assessed value", "total assessed"], "meaning": "Total assessed value from the production pull." },
    { "header": "Improvement Value", "key": "improvement_value", "aliases": ["improvement", "improvements"], "meaning": "Improvement / building assessed value." },
    { "header": "Land Value", "key": "land_value", "aliases": ["land"], "meaning": "Land assessed value." },
    { "header": "Owner 1 Name", "key": "owner_1_name", "aliases": ["owner", "owner name"], "meaning": "Primary owner as returned by the collector." },
    { "header": "Legal Description", "key": "legal_description", "aliases": ["legal", "legal desc"], "meaning": "Legal description when the collector provides one." }
  ],
  "portal_look_for": [
    { "header": "Parcel Number", "roles": ["parcel"], "hints": ["parcel", "apn", "pin", "folio"] },
    { "header": "Tax Id", "roles": ["account"], "hints": ["tax id", "account", "bill number"] },
    { "header": "Owner 1 Name", "roles": ["owner"], "hints": ["owner", "last name"] },
    { "header": "Legal Description", "roles": ["address"], "hints": ["situs", "address", "legal"] },
    { "header": "Bill Amount", "roles": ["amount"], "hints": ["bill amount", "tax amount"] },
    { "header": "Balance Due", "roles": ["amount"], "hints": ["balance", "amount due"] },
    { "header": "As Of", "roles": ["date"], "hints": ["as of", "as-of"] },
    { "header": "Bill Year", "roles": ["year"], "hints": ["tax year", "bill year"] }
  ]
}
