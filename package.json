{
  "name": "tax-certificate-processor",
  "version": "1.0.0",
  "description": "WebPoint Tax Certificate Processor — TCS/TPA/RDS fused with Search Spul RAG, embeddable for Squarespace members.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "pay": "bash scripts/ru.sh",
    "dev": "node --watch src/server.js",
    "map:build": "node scripts/build-us-map.js",
    "migrate": "node scripts/migrate.js",
    "import:workplace": "node scripts/import-workplace.js",
    "import:finale": "node scripts/import-finale.js",
    "import:master": "node scripts/import-master-counties.js",
    "import:searching": "node scripts/import-searching-inventory.js",
    "import:extractor-urls": "node scripts/import-extractor-urls.js",
    "seed:searching-extractors": "python3 scripts/seed-searching-extractors.py",
    "revalidate:searching": "node scripts/validate-extractors.js --all",
    "validate:extractors": "node scripts/validate-extractors.js --all",
    "validate:apply": "node scripts/apply-validation.js",
    "validate:families": "node scripts/validate-families.js",
    "validate:pass2": "node scripts/validate-extractors.js --pass2",
    "deepshake:mac": "bash scripts/deepshake-hunt-mac.sh",
    "sync:sheet": "node scripts/sync-sheet-counties.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.52.0",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0"
  }
}
